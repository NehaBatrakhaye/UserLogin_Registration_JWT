@model UserLogin_Registration.Model.EmailEntity

@{
    ViewData["Title"] = "Home Page";
}

<div class="card shadow border-0">
    <div class="card-header bg-secondary bg-gradient">
        <div class="row">
            <div class="col-12 text-center">
                <h2>Send Email</h2>
            </div>
        </div>

    </div>
    
    <div class="card-body p-2">
        <form method="post" asp-action="SendEmail" enctype="multipart/form-data">
            
            @if (ViewBag.Message != null)
            {
                <div id="successmessage" class="alert alert-success mt-3 text-center col-12">
                    @ViewBag.Message;
                </div>
            }
            
            
            <div class="col-12">
                <label class="align-context-lg-start">To</label>
            </div>
            

        </form>

    </div>

</div>
